  "authors": ["moonstruck.nectar", "Mayflower"],
  "contact": {
    "sources": "https://github.com/femboyindustries/random-datapack",
    "homepage": "https://modrinth.com/mod/ultra-datapack-shuffle"
  },

  "license": "CC0-1.0",
